{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["airbnb-base"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".ts", ".js", ".json"]
      }
    },
    "import/extensions": [".js", ".ts"]
  },
  "rules": {
    "func-names": "off",
    "camelcase": "off",
    "no-underscore-dangle": "off",
    "no-console": "warn",
    "max-len": ["error", { "code": 120 }],
    "no-param-reassign": "off",
    "no-void": "off",
    "no-shadow": "off",
    "no-return-assign": "off",
    "consistent-return": "off",
    "@typescript-eslint/no-shadow": "warn",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "ts": "never"
      }
    ],
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
